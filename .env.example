# Режим отладки (True для разработки, False для продакшена)
DEBUG=True

# Секретный ключ Django (сгенерируйте уникальный для продакшена)
SECRET_KEY=django-insecure-change-this-in-production

# Настройки базы данных
DB_NAME=restaurant_db
DB_USER=postgres
DB_PASS=postgres
DB_HOST=db
DB_PORT=5432

# Разрешенные хосты (для продакшена укажите домен и IP)
ALLOWED_HOSTS=localhost,127.0.0.1

# Email настройки (опционально, для уведомлений)
EMAIL_BACKEND=
EMAIL_HOST=
EMAIL_PORT=
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_SSL=
DEFAULT_FROM_EMAIL=

# Яндекс Карты API
YANDEX_MAPS_API_KEY=